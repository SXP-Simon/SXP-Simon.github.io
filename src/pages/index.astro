---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import AuthorBrand from "@/components/AuthorBrand.astro";
import DreamLandscape from "@/components/DreamLandscape.astro";
import { scenes } from "@/data/broadcast";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";
import "@/styles/broadcast.css";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const posts = getSortedPosts(await getCollection("posts")).slice(
  0,
  config.posts.perIndex
);
const first = scenes[0];
---

<Layout
  description="Helian 的夜間放送。由《素晴日》相关的图像与文字编排而成的五幕视觉叙事。"
>
  <night-broadcast class="broadcast">
    <a class="skip-broadcast" href="#main-content">跳到正文</a>
    <header class="station-header">
      <div class="station-shell masthead">
        <AuthorBrand />
        <nav class="station-nav" aria-label="主导航">
          <a href={url("posts")}>文章</a>
          {config.features.showArchives && <a href={url("archives")}>归档</a>}
          <a href={url("about")}>关于</a>
        </nav>
        <div class="station-tools">
          {
            config.features.search && (
              <a
                class="station-search"
                href={url("search")}
                aria-label="搜索文章"
                title="搜索文章"
              >
                <Icon name="lucide:search" size={17} />
              </a>
            )
          }
          <button
            class="audio-toggle"
            data-audio
            type="button"
            aria-pressed="false"
            aria-label="开启环境音"
            title="开启环境音"
          >
            <Icon name="lucide:volume-x" size={18} class="audio-off" />
            <Icon name="lucide:volume-2" size={18} class="audio-on" />
          </button>
        </div>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <section class="airscape" aria-label="互动叙事放送" data-stage>
        <DreamLandscape frame={first.cover} />
        <div class="airshade" aria-hidden="true"></div>
        <div class="station-shell airframe">
          <div class="aircopy" data-copy>
            <h1 class="airtitle" tabindex="-1" data-heading>
              <span data-title-top>{first.title[0]}</span><em data-title-bottom
                >{first.title[1]}</em
              >
            </h1>
            <div class="air-actions">
              <button type="button" class="listen-button" data-read
                ><Icon name="lucide:play" size={14} />进入叙事</button
              >
            </div>
          </div>
          <section class="voice-panel" data-story hidden aria-label="场景独白">
            <span class="voice-speaker" data-speaker></span>
            <p class="voice-line" data-line aria-live="polite"></p>
          </section>
          <div class="signal-footer">
            <div class="voice-controls" data-reading-controls hidden>
              <button
                type="button"
                class="close-reading"
                data-close
                aria-label="退出叙事"
              >
                <Icon name="lucide:corner-up-left" size={15} /><span>退出</span>
              </button>
              <button
                type="button"
                data-back
                aria-label="上一句"
                title="上一句"
              >
                <Icon name="lucide:arrow-left" size={17} />
              </button>
              <button type="button" class="voice-advance" data-next-line>
                <span>下一句</span><Icon name="lucide:arrow-right" size={19} />
              </button>
            </div>
            <nav class="scene-register" aria-label="切换场景">
              {
                scenes.map((scene, i) => (
                  <button
                    type="button"
                    data-chapter={i}
                    aria-pressed={i === 0}
                    aria-label={`第${i + 1}幕，${scene.label}`}
                    title={scene.label}
                  >
                    {["一", "二", "三", "四", "五"][i]}
                  </button>
                ))
              }
            </nav>
          </div>
        </div>
      </section>
      <section
        class="station-shell scene-shelf"
        id="scene-index"
        aria-labelledby="scene-index-title"
      >
        <div class="shelf-heading">
          <h2 id="scene-index-title">场景索引</h2>
        </div>
        <div class="scene-cards">
          {
            scenes.map((scene, i) => (
              <button
                type="button"
                class="scene-card"
                data-tune={i}
                aria-pressed={i === 0}
                aria-label={`切换至第 ${i + 1} 幕，${scene.label}`}
              >
                <span class="card-art">
                  <DreamLandscape frame={scene.cover} small />
                </span>
                <span class="card-legend">
                  <>
                    <strong>{scene.label}</strong>
                    <i aria-hidden="true">
                      <Icon name="lucide:arrow-up-right" size={17} />
                    </i>
                  </>
                </span>
              </button>
            ))
          }
        </div>
      </section>
      <section class="station-shell journal" aria-labelledby="journal-title">
        <div class="shelf-heading">
          <h2 id="journal-title">最近手记</h2><a
            class="journal-index"
            href={url("posts")}
            >全部文章 <Icon name="lucide:arrow-up-right" size={14} /></a
          >
        </div>
        <ul class="notes">
          {
            posts.map(({ id, filePath, data }) => (
              <li>
                <a href={getPostUrl(id, filePath, locale)}>
                  <>
                    <span>{data.title}</span>
                    <Icon name="lucide:arrow-up-right" size={17} />
                  </>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <footer class="station-shell signoff">
      <span>© {new Date().getFullYear()} Helian</span><a href={url("rss.xml")}
        >RSS <Icon name="lucide:rss" size={13} /></a
      >
    </footer>
    <div class="sr-only" role="status" data-status></div>
  </night-broadcast>
</Layout>

<script>
  import "@/scripts/broadcast";
</script>
