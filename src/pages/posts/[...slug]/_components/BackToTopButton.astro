---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div
  id="btt-btn-container"
  class:list={[
    "fixed inset-e-4 bottom-8 z-50",
    "md:sticky md:inset-e-auto md:float-end md:me-1",
    "translate-y-14 opacity-0 transition duration-500",
  ]}
>
  <button
    data-button="back-to-top"
    class:list={[
      "group bg-background relative px-2 py-1",
      "size-14 rounded-full shadow-xl",
      "md:h-8 md:w-fit md:rounded-md md:shadow-none md:focus-visible:rounded-none",
      "md:bg-background/35 md:bg-clip-padding md:backdrop-blur-lg",
    ]}
  >
    <span
      id="progress-indicator"
      class="absolute inset-0 -z-10 block size-14 scale-110 rounded-full bg-transparent md:hidden md:h-8 md:rounded-md"
    ></span>
    <IconArrowLeft class="inline-block rotate-90 md:hidden" />
    <span class="group-hover:text-accent sr-only text-sm md:not-sr-only">
      <IconArrowNarrowUp class="inline-block size-4" />
      {t.post.backToTop}
    </span>
  </button>
</div>

<script>
  import { onPageMount } from "@/scripts/page-lifecycle";
  onPageMount(signal => {
    const container = document.querySelector<HTMLElement>("#btt-btn-container");
    const button = document.querySelector<HTMLButtonElement>(
      "[data-button='back-to-top']"
    );
    const indicator = document.querySelector<HTMLElement>(
      "#progress-indicator"
    );
    if (!container || !button || !indicator) return;
    button.addEventListener(
      "click",
      () =>
        window.scrollTo({
          top: 0,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
        }),
      { signal }
    );
    let frame = 0;
    const update = () => {
      frame = 0;
      const root = document.documentElement;
      const total = root.scrollHeight - root.clientHeight;
      const ratio =
        total > 0 ? Math.min(1, Math.max(0, root.scrollTop / total)) : 0;
      const percent = Math.round(ratio * 100);
      indicator.style.backgroundImage = `conic-gradient(var(--accent) ${percent}%, transparent ${percent}%)`;
      const visible = ratio > 0.3;
      container.classList.toggle("opacity-100", visible);
      container.classList.toggle("translate-y-0", visible);
      container.classList.toggle("opacity-0", !visible);
      container.classList.toggle("translate-y-14", !visible);
      container.style.pointerEvents = visible ? "auto" : "none";
      button.tabIndex = visible ? 0 : -1;
    };
    document.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true, signal }
    );
    update();
    return () => cancelAnimationFrame(frame);
  });
</script>
