---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
  variant?: "sidebar" | "inline";
};

const { headings, variant = "sidebar" } = Astro.props;

// Filter to h2 and h3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 0 &&
    (variant === "inline" ? (
      /* Mobile / Tablet Collapsible TOC */
      <details class="toc-inline border-border bg-foreground/5 not-prose my-6 rounded-xl border p-4 xl:hidden">
        <summary class="text-foreground hover:text-accent flex cursor-pointer items-center gap-2 font-medium select-none">
          <svg
            class="text-accent inline-block size-4"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </>
          </svg>
          <span>目录导航 ({tocHeadings.length})</span>
        </summary>
        <nav class="border-border/50 mt-3 max-h-72 overflow-y-auto border-s ps-2 text-sm">
          <ul class="flex flex-col gap-1.5 py-1">
            {tocHeadings.map(heading => (
              <li class={heading.depth === 3 ? "ms-3 text-xs" : "font-medium"}>
                <a
                  href={`#${heading.slug}`}
                  class="text-muted-foreground hover:text-accent block py-0.5 transition-colors"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    ) : (
      /* Desktop Sticky Sidebar TOC */
      <aside class="toc-sidebar not-prose sticky top-24 hidden max-h-[calc(100vh-7rem)] w-64 shrink-0 self-start overflow-y-auto text-sm xl:block">
        <div class="border-border/60 border-s ps-4">
          <h2 class="text-muted-foreground mb-3 flex items-center gap-2 text-xs font-semibold tracking-wider uppercase">
            <svg
              class="text-accent size-4"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <>
                <line x1="8" y1="6" x2="21" y2="6" />
                <line x1="8" y1="12" x2="21" y2="12" />
                <line x1="8" y1="18" x2="21" y2="18" />
                <line x1="3" y1="6" x2="3.01" y2="6" />
                <line x1="3" y1="12" x2="3.01" y2="12" />
                <line x1="3" y1="18" x2="3.01" y2="18" />
              </>
            </svg>
            <span>本页目录</span>
          </h2>
          <nav id="toc-nav">
            <ul class="flex flex-col gap-0.5 text-[13px] leading-relaxed">
              {tocHeadings.map(heading => (
                <li
                  class={heading.depth === 3 ? "ms-3 text-xs" : "font-medium"}
                >
                  <a
                    href={`#${heading.slug}`}
                    data-slug={heading.slug}
                    class="toc-link text-muted-foreground hover:text-accent -ms-[17px] block border-s-2 border-transparent py-1 ps-[15px] transition-all"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    ))
}

<script>
  import { onPageMount } from "@/scripts/page-lifecycle";
  onPageMount(signal => {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc-link")
    );
    if (!links.length) return;
    const headings = links
      .map(link => {
        const slug = link.dataset.slug ?? "";
        return (
          document.getElementById(slug) ??
          document.getElementById(decodeURIComponent(slug))
        );
      })
      .filter((heading): heading is HTMLElement => Boolean(heading));
    let active = "";
    let frame = 0;
    const update = () => {
      frame = 0;
      let current = headings[0]?.id;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 140) current = heading.id;
        else break;
      }
      if (!current || active === current) return;
      active = current;
      for (const link of links) {
        const match = decodeURIComponent(link.dataset.slug ?? "") === current;
        for (const cls of ["text-accent", "font-semibold", "!border-accent"])
          link.classList.toggle(cls, match);
        for (const cls of ["text-muted-foreground", "border-transparent"])
          link.classList.toggle(cls, !match);
      }
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true, signal }
    );
    update();
    return () => cancelAnimationFrame(frame);
  });
</script>
