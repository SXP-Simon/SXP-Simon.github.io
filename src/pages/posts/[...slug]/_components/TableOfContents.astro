---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
  variant?: "sidebar" | "inline";
};

const { headings, variant = "sidebar" } = Astro.props;

// Filter to h2 and h3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 0 && (
    variant === "inline" ? (
      /* Mobile / Tablet Collapsible TOC */
      <details class="toc-inline my-6 rounded-xl border border-border bg-foreground/5 p-4 xl:hidden not-prose">
        <summary class="cursor-pointer font-medium text-foreground hover:text-accent flex items-center gap-2 select-none">
          <svg class="size-4 text-accent inline-block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          <span>目录导航 ({tocHeadings.length})</span>
        </summary>
        <nav class="mt-3 max-h-72 overflow-y-auto ps-2 border-s border-border/50 text-sm">
          <ul class="flex flex-col gap-1.5 py-1">
            {tocHeadings.map(heading => (
              <li class={heading.depth === 3 ? "ms-3 text-xs" : "font-medium"}>
                <a
                  href={`#${heading.slug}`}
                  class="text-muted-foreground hover:text-accent transition-colors block py-0.5"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    ) : (
      /* Desktop Sticky Sidebar TOC */
      <aside class="toc-sidebar hidden xl:block not-prose w-64 shrink-0 sticky top-24 self-start max-h-[calc(100vh-7rem)] overflow-y-auto text-sm">
        <div class="border-s border-border/60 ps-4">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3 flex items-center gap-2">
            <svg class="size-4 text-accent" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            <span>本页目录</span>
          </h2>
          <nav id="toc-nav">
            <ul class="flex flex-col gap-0.5 text-[13px] leading-relaxed">
              {tocHeadings.map(heading => (
                <li class={heading.depth === 3 ? "ms-3 text-xs" : "font-medium"}>
                  <a
                    href={`#${heading.slug}`}
                    data-slug={heading.slug}
                    class="toc-link text-muted-foreground hover:text-accent transition-all block py-1 border-s-2 border-transparent -ms-[17px] ps-[15px]"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    )
  )
}

<script is:inline data-astro-rerun>
  function initTocScrollSpy() {
    const links = Array.from(document.querySelectorAll(".toc-link"));
    if (links.length === 0) return;

    const slugs = links.map(link => link.getAttribute("data-slug"));
    const headingElements = slugs
      .map(slug => {
        try {
          return document.getElementById(slug) || document.getElementById(decodeURIComponent(slug));
        } catch {
          return document.getElementById(slug);
        }
      })
      .filter(Boolean);

    if (headingElements.length === 0) return;

    let activeSlug = null;

    function updateActiveHeading() {
      const scrollPosition = window.scrollY + 140;
      let current = null;

      for (let i = 0; i < headingElements.length; i++) {
        const heading = headingElements[i];
        if (heading.offsetTop <= scrollPosition) {
          current = heading.id;
        } else {
          break;
        }
      }

      if (!current && headingElements.length > 0) {
        current = headingElements[0].id;
      }

      if (current && current !== activeSlug) {
        activeSlug = current;
        links.forEach(link => {
          const linkSlug = link.getAttribute("data-slug");
          const isMatch =
            linkSlug === current ||
            linkSlug === encodeURIComponent(current) ||
            (linkSlug && decodeURIComponent(linkSlug) === current);

          if (isMatch) {
            link.classList.remove("text-muted-foreground", "border-transparent");
            link.classList.add("text-accent", "font-semibold", "!border-accent");
          } else {
            link.classList.remove("text-accent", "font-semibold", "!border-accent");
            link.classList.add("text-muted-foreground", "border-transparent");
          }
        });
      }
    }

    window.addEventListener("scroll", updateActiveHeading, { passive: true });
    updateActiveHeading();
  }

  initTocScrollSpy();
  document.addEventListener("astro:after-swap", initTocScrollSpy);
</script>
