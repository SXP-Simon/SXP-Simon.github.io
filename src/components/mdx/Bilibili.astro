---
import IconBilibili from "@/assets/icons/socials/bilibili.svg";

interface Props {
  bvid?: string;
  aid?: string;
  page?: number;
  autoplay?: boolean;
  title?: string;
}

const { bvid, aid, page = 1, autoplay = false, title } = Astro.props;
const src = bvid
  ? `https://player.bilibili.com/player.html?bvid=${bvid}&page=${page}&autoplay=${autoplay ? 1 : 0}&high_quality=1&as_wide=1`
  : `https://player.bilibili.com/player.html?aid=${aid}&page=${page}&autoplay=${autoplay ? 1 : 0}&high_quality=1&as_wide=1`;

const directUrl = bvid
  ? `https://www.bilibili.com/video/${bvid}?p=${page}`
  : `https://www.bilibili.com/video/av${aid}?p=${page}`;
---

<figure class="my-6 not-prose">
  <div class="aspect-video w-full overflow-hidden rounded-xl border border-border bg-foreground/5 shadow-sm">
    <iframe
      src={src}
      allowfullscreen="true"
      loading="lazy"
      class="size-full border-0"
      title={title || "Bilibili Video"}
    ></iframe>
  </div>
  {
    title && (
      <figcaption class="mt-2.5 flex items-center justify-center gap-1.5 text-center text-xs text-muted-foreground">
        <a
          href={directUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 hover:text-accent transition-colors"
          title="在哔哩哔哩打开原视频"
        >
          <IconBilibili class="size-4 shrink-0 text-[#00AEEC] inline-block" />
          <span>{title}</span>
        </a>
      </figcaption>
    )
  }
</figure>
