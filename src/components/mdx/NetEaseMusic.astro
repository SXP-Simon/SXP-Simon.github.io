---
import IconNetEase from "@/assets/icons/socials/netease.svg";

type MusicType =
  | 0
  | 1
  | 2
  | 3
  | "song"
  | "playlist"
  | "album"
  | "program"
  | "dj"
  | "radio";

interface Props {
  id: string | number;
  type?: MusicType;
  auto?: 0 | 1;
  title?: string;
  artist?: string;
}

const { id, type = 2, auto = 0, title, artist } = Astro.props;

let numType = 2;
let typeLabel = "网易云单曲";
let isTall = false;
let directUrl = `https://music.163.com/#/song?id=${id}`;

if (type === 0 || type === "playlist") {
  numType = 0;
  typeLabel = "网易云歌单";
  isTall = true;
  directUrl = `https://music.163.com/#/playlist?id=${id}`;
} else if (type === 1 || type === "album") {
  numType = 1;
  typeLabel = "网易云专辑";
  isTall = true;
  directUrl = `https://music.163.com/#/album?id=${id}`;
} else if (type === 3 || type === "program" || type === "dj" || type === "radio") {
  numType = 3;
  typeLabel = "网易云电台 / 声音";
  isTall = false;
  directUrl = `https://music.163.com/#/program?id=${id}`;
}

const iframeHeight = isTall ? 450 : 86;
const playerHeight = isTall ? 430 : 66;
---

<figure class="my-6 not-prose max-w-xl">
  <div class="overflow-hidden rounded-2xl border border-border bg-white dark:bg-[#18181b] shadow-sm transition-all hover:shadow-md">
    <iframe
      class="w-full border-0 block"
      style={{ height: `${iframeHeight}px` }}
      loading="lazy"
      allow="autoplay; encrypted-media; fullscreen"
      src={`https://music.163.com/outchain/player?type=${numType}&id=${id}&auto=${auto}&height=${playerHeight}`}
    ></iframe>
  </div>
  <figcaption class="mt-2 flex items-center justify-between px-1 text-xs text-muted-foreground">
    <div class="flex items-center gap-1.5 truncate">
      <IconNetEase class="size-4 shrink-0 text-[#E60026] inline-block" />
      <span class="truncate font-medium text-foreground/80">
        {title || typeLabel}
        {artist && <span class="text-muted-foreground font-normal"> - {artist}</span>}
      </span>
    </div>
    <a
      href={directUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center gap-1 hover:text-accent transition-colors ml-2"
      title="在网易云音乐打开"
    >
      <span>在网易云打开</span>
      <svg class="size-3 inline-block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
    </a>
  </figcaption>
</figure>
