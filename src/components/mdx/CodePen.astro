---
interface Props {
  id: string; // e.g. "https://codepen.io/argyleink/pen/eYpRgpy" or pen hash
  title?: string;
  height?: number | string;
}

const { id, title = "CodePen Embed", height = 400 } = Astro.props;
const src = id.startsWith("http")
  ? id.replace("/pen/", "/embed/") + "?default-tab=html%2Cresult"
  : `https://codepen.io/anon/embed/${id}?default-tab=html%2Cresult`;
---

<div class="my-6 w-full overflow-hidden rounded-xl border border-border shadow-sm">
  <iframe
    height={height}
    style="width: 100%;"
    title={title}
    src={src}
    loading="lazy"
    allowfullscreen
    class="border-0 w-full"
  >
  </iframe>
</div>
