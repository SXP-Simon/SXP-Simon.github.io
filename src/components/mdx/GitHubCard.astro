---
import { Icon } from "astro-icon/components";

interface Props {
  repo: string; // e.g. "SXP-Simon/SXP-Simon.github.io"
  description?: string;
  language?: string;
  stars?: number | string;
}

const { repo, description, language = "TypeScript", stars } = Astro.props;
const repoUrl = `https://github.com/${repo}`;
const [owner, name] = repo.split("/");
---

<a
  href={repoUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group not-prose my-6 flex flex-col justify-between rounded-xl border border-border bg-foreground/5 p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:shadow-md"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-2">
      <Icon name="tabler:brand-github" class="size-5 text-foreground/80 group-hover:text-accent" />
      <span class="font-semibold text-foreground group-hover:text-accent text-base">
        {owner} / <span class="text-accent">{name || owner}</span>
      </span>
    </div>
    <Icon name="lucide:external-link" class="size-4 text-foreground/40 group-hover:text-accent" />
  </div>

  {description && <p class="mt-2 text-sm text-foreground/75 leading-relaxed">{description}</p>}

  <div class="mt-4 flex items-center gap-4 text-xs text-foreground/60">
    {language && (
      <span class="flex items-center gap-1.5">
        <span class="size-2.5 rounded-full bg-accent inline-block"></span>
        {language}
      </span>
    )}
    {stars !== undefined && (
      <span class="flex items-center gap-1">
        <Icon name="lucide:star" class="size-3.5 text-yellow-500" />
        {stars}
      </span>
    )}
    <span class="flex items-center gap-1">
      <Icon name="lucide:git-fork" class="size-3.5" />
      GitHub Repo
    </span>
  </div>
</a>
