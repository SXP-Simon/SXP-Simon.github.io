---
interface Props {
  src: string;
  title?: string;
  artist?: string;
}

const { src, title, artist } = Astro.props;
---

<div class="my-4 flex flex-col gap-2 rounded-xl border border-border bg-foreground/5 p-4">
  {
    (title || artist) && (
      <div class="flex items-baseline justify-between text-sm">
        {title && <span class="font-medium text-foreground">{title}</span>}
        {artist && <span class="text-xs text-foreground/60">{artist}</span>}
      </div>
    )
  }
  <audio controls class="w-full h-8" preload="metadata">
    <source src={src} />
    您的浏览器不支持音频播放。
  </audio>
</div>
