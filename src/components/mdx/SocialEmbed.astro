---
import { Icon } from "astro-icon/components";

interface Props {
  url: string;
  platform?:
    | "zhihu"
    | "xiaohongshu"
    | "reddit"
    | "jike"
    | "wechat"
    | "bilibili"
    | "x"
    | "web";
  author?: string;
  handle?: string;
  avatar?: string;
  date?: string;
  title?: string;
  content?: string;
  image?: string;
  likes?: number | string;
  comments?: number | string;
}

const {
  url,
  platform: customPlatform,
  author: customAuthor,
  handle: customHandle,
  avatar: customAvatar,
  date: customDate,
  title: customTitle,
  content: customContent,
  image: customImage,
  likes,
  comments,
} = Astro.props;

// Auto-detect platform from URL if not explicitly provided
function detectPlatform(u: string): string {
  try {
    const host = new URL(u).hostname.toLowerCase();
    if (host.includes("zhihu.com")) return "zhihu";
    if (host.includes("xiaohongshu.com") || host.includes("xhslink.com"))
      return "xiaohongshu";
    if (host.includes("reddit.com")) return "reddit";
    if (host.includes("jike") || host.includes("okjike.com")) return "jike";
    if (host.includes("qq.com") || host.includes("weixin")) return "wechat";
    if (host.includes("bilibili.com")) return "bilibili";
    if (host.includes("x.com") || host.includes("twitter.com")) return "x";
    return "web";
  } catch {
    return "web";
  }
}

const platform = customPlatform || detectPlatform(url);

// Fetch OpenGraph metadata from URL automatically
let fetchedMeta: {
  title?: string;
  description?: string;
  image?: string;
  siteName?: string;
  author?: string;
} = {};

try {
  const res = await fetch(url, {
    headers: {
      "User-Agent":
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      Accept:
        "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
    },
    signal: AbortSignal.timeout(4000),
  });
  if (res.ok) {
    const html = await res.text();

    const getMeta = (prop: string) => {
      const match =
        html.match(
          new RegExp(
            `<meta[^>]+(?:property|name)=["'](?:og:|twitter:)?${prop}["'][^>]+content=["']([^"']+)["']`,
            "i"
          )
        ) ||
        html.match(
          new RegExp(
            `<meta[^>]+content=["']([^"']+)["'][^>]+(?:property|name)=["'](?:og:|twitter:)?${prop}["']`,
            "i"
          )
        );
      return match ? match[1] : undefined;
    };

    const docTitle = html.match(/<title[^>]*>([^<]+)<\/title>/i)?.[1];

    fetchedMeta = {
      title: getMeta("title") || docTitle,
      description: getMeta("description"),
      image: getMeta("image"),
      siteName: getMeta("site_name"),
      author: getMeta("author"),
    };
  }
} catch (e) {
  // Graceful fallback
}

const platformMap: Record<
  string,
  { name: string; icon: string; color: string; bgHover: string }
> = {
  zhihu: {
    name: "知乎",
    icon: "simple-icons:zhihu",
    color: "text-[#0066FF]",
    bgHover: "hover:border-[#0066FF]/50",
  },
  xiaohongshu: {
    name: "小红书",
    icon: "simple-icons:xiaohongshu",
    color: "text-[#FF2442]",
    bgHover: "hover:border-[#FF2442]/50",
  },
  reddit: {
    name: "Reddit",
    icon: "simple-icons:reddit",
    color: "text-[#FF4500]",
    bgHover: "hover:border-[#FF4500]/50",
  },
  jike: {
    name: "即刻",
    icon: "lucide:sparkles",
    color: "text-[#FFE411]",
    bgHover: "hover:border-yellow-400/50",
  },
  wechat: {
    name: "微信",
    icon: "simple-icons:wechat",
    color: "text-[#07C160]",
    bgHover: "hover:border-[#07C160]/50",
  },
  bilibili: {
    name: "哔哩哔哩",
    icon: "simple-icons:bilibili",
    color: "text-[#00A1D6]",
    bgHover: "hover:border-[#00A1D6]/50",
  },
  x: {
    name: "X (Twitter)",
    icon: "simple-icons:x",
    color: "text-foreground",
    bgHover: "hover:border-accent",
  },
  web: {
    name: fetchedMeta.siteName || "网页",
    icon: "lucide:globe",
    color: "text-accent",
    bgHover: "hover:border-accent",
  },
};

const currentConfig = platformMap[platform] || platformMap.web;

const finalTitle = customTitle || fetchedMeta.title;
const finalContent = customContent || fetchedMeta.description || "";
const finalImage = customImage || fetchedMeta.image;
const finalAuthor = customAuthor || fetchedMeta.author || currentConfig.name;
---

<div class="my-6 max-w-xl not-prose">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class={`group block rounded-2xl border border-border bg-foreground/5 p-4.5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md ${currentConfig.bgHover}`}
  >
    <!-- Header -->
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        {
          customAvatar ? (
            <img
              src={customAvatar}
              alt={finalAuthor}
              class="size-10 rounded-full border border-border object-cover"
            />
          ) : (
            <div class="size-10 rounded-full border border-border bg-foreground/10 flex items-center justify-center font-bold text-foreground flex-shrink-0">
              {finalAuthor.charAt(0)}
            </div>
          )
        }
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="font-semibold text-foreground text-sm truncate"
              >{finalAuthor}</span
            >
            {
              customHandle && (
                <span class="text-xs text-foreground/50 truncate">
                  {customHandle}
                </span>
              )
            }
          </div>
          {
            customDate && (
              <p class="text-xs text-foreground/40 mt-0.5">{customDate}</p>
            )
          }
        </div>
      </div>

      <!-- Platform Badge -->
      <div
        class="flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-border bg-background/50 text-xs font-medium flex-shrink-0"
      >
        <Icon
          name={currentConfig.icon}
          class={`size-3.5 ${currentConfig.color}`}
        />
        <span class="text-foreground/70">{currentConfig.name}</span>
      </div>
    </div>

    <!-- Title (if present) -->
    {
      finalTitle && (
        <h4 class="mt-3 text-base font-semibold text-foreground group-hover:text-accent transition-colors leading-snug">
          {finalTitle}
        </h4>
      )
    }

    <!-- Content Snippet -->
    {
      finalContent && (
        <p
          class={`mt-2.5 text-sm text-foreground/80 leading-relaxed ${finalImage ? "line-clamp-3" : "line-clamp-4"}`}
        >
          {finalContent}
        </p>
      )
    }

    <!-- Optional Thumbnail Image -->
    {
      finalImage && (
        <div class="mt-3 overflow-hidden rounded-xl border border-border max-h-56">
          <img
            src={finalImage}
            alt="post visual"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </div>
      )
    }

    <!-- Footer Stats / CTA -->
    <div
      class="mt-3.5 pt-3 border-t border-border/60 flex items-center justify-between text-xs text-foreground/50"
    >
      <div class="flex items-center gap-4">
        {
          likes !== undefined && (
            <span class="flex items-center gap-1">
              <Icon name="lucide:heart" class="size-3.5 text-red-500/80" />
              {likes}
            </span>
          )
        }
        {
          comments !== undefined && (
            <span class="flex items-center gap-1">
              <Icon name="lucide:message-circle" class="size-3.5" />
              {comments}
            </span>
          )
        }
      </div>
      <span
        class="flex items-center gap-1 text-accent font-medium group-hover:underline"
      >
        查看原帖
        <Icon name="lucide:arrow-up-right" class="size-3.5" />
      </span>
    </div>
  </a>
</div>
