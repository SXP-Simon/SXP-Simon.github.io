---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string;
  class?: string;
};

const { pageTitle, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main data-backUrl={backUrl} id="main-content" class="app-layout station-main">
  <header class="section-heading">
    <h1>{pageTitle}</h1>
    <div class="dial" aria-hidden="true"><i></i></div>
  </header>
  <div class={className}><slot /></div>
</main>

<style>
  .station-main {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
    border-bottom: 1px solid var(--border);
    padding: clamp(2.6rem, 7vw, 5rem) 0 clamp(1.5rem, 3.5vw, 2.65rem);
    margin-bottom: 1.5rem;
  }
  .section-heading::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 2.8rem;
    height: 2px;
    background: var(--accent);
  }
  h1 {
    min-width: 0;
    font: 400 clamp(2.75rem, 7vw, 4.5rem)/1.18
      var(--station-display, var(--station-serif));
    letter-spacing: 0.025em;
    overflow-wrap: anywhere;
  }
  .dial {
    flex: 0 0 auto;
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(4.5rem, 12vw, 8rem);
    aspect-ratio: 1.6;
    color: var(--accent);
    overflow: hidden;
  }
  .dial i {
    width: 61%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(to bottom, var(--sky-glow), var(--accent));
    mask: linear-gradient(
      to bottom,
      #000 48%,
      transparent 48% 51%,
      #000 51% 58%,
      transparent 58% 62%,
      #000 62% 68%,
      transparent 68% 74%,
      #000 74% 80%,
      transparent 80% 87%,
      #000 87% 91%,
      transparent 91%
    );
  }
  .dial::before,
  .dial::after {
    content: "";
    position: absolute;
    inset: 52% 0 auto;
    border-top: 1px solid color-mix(in srgb, currentColor 42%, transparent);
  }
  .dial::after {
    inset: 59% 20% auto 10%;
    opacity: 0.5;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
