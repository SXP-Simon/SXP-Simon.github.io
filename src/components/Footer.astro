---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  class:list={["station-footer", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="footer-row">
    <Socials />
    <a href={getRelativeLocaleUrl(locale, "rss.xml")} class="rss">RSS</a>
  </div>
</footer>

<style>
  .station-footer {
    max-width: none;
    width: 100%;
    color: var(--muted-foreground);
  }
  .footer-row {
    position: relative;
    max-width: 74rem;
    margin: auto;
    padding: 1.65rem clamp(1rem, 4vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: flex-end;
    align-items: center;
  }
  .footer-row::before {
    content: "";
    position: absolute;
    inset: 0 clamp(1rem, 4vw, 3rem) auto;
    border-top: 1px solid var(--border);
  }
  .rss {
    font: 0.67rem/1.5 var(--station-mono);
    letter-spacing: 0.15em;
    color: var(--accent);
    padding-left: 0.9rem;
    border-left: 1px solid var(--border);
  }
  .footer-row a:hover {
    color: var(--foreground);
  }
</style>
