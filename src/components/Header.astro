---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import IconGithub from "@/assets/icons/socials/github.svg";
import AuthorBrand from "./AuthorBrand.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
const section = stripLocale(stripBase(Astro.url.pathname), locale)
  .split("/")
  .filter(Boolean)[0];
const pages = [
  ["posts", t.nav.posts],
  ...(features.showArchives ? [["archives", t.nav.archives]] : []),
  ["tags", t.nav.tags],
  ["about", t.nav.about],
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="focus:bg-background sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:p-3"
>
  {t.a11y.skipToContent}
</a>

<header id="site-header">
  <div class="header-row">
    <AuthorBrand />
    <nav
      id="nav-menu"
      aria-label={locale.startsWith("zh") ? "主导航" : "Main navigation"}
    >
      <ul id="menu-items">
        {
          pages.map(([path, name]) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, path)}
                aria-current={section === path ? "page" : undefined}
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="tools">
        {
          features.search !== false && (
            <a
              href={getRelativeLocaleUrl(locale, "search")}
              title={t.nav.search}
              aria-label={t.nav.search}
              aria-current={section === "search" ? "page" : undefined}
            >
              <IconSearch />
            </a>
          )
        }
        {
          features.lightAndDarkMode && (
            <button
              type="button"
              id="theme-btn"
              title={t.a11y.toggleTheme}
              aria-label={t.a11y.toggleTheme}
              aria-pressed="false"
            >
              <>
                <IconMoon class="dark:hidden" />
                <IconSunHigh class="hidden dark:block" />
              </>
            </button>
          )
        }
        <a
          href="https://github.com/SXP-Simon/SXP-Simon.github.io"
          title="GitHub 博客仓库"
          aria-label="GitHub 博客仓库"
        >
          <IconGithub />
        </a>
        <button
          type="button"
          id="menu-btn"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="menu-items"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <IconMenuDeep class="open-icon" /><IconX class="close-icon" />
        </button>
      </div>
    </nav>
  </div>
  <div id="reading-progress" aria-hidden="true"></div>
</header>

<style>
  #site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 83%, transparent);
    backdrop-filter: blur(12px);
  }
  .header-row {
    max-width: 74rem;
    min-height: 4.9rem;
    margin: auto;
    padding: 0 clamp(1rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  #nav-menu,
  .tools,
  #menu-items {
    display: flex;
    align-items: center;
  }
  #menu-items a:hover,
  .tools :is(a, button):hover {
    color: var(--accent);
  }
  #nav-menu {
    gap: 1.5rem;
  }
  #menu-items {
    gap: 1.6rem;
  }
  #menu-items a {
    display: block;
    padding: 0.6rem 0.1rem;
    font-size: 0.85rem;
    font-family: var(--station-serif);
    letter-spacing: 0.09em;
  }
  #menu-items a[aria-current="page"] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.5rem;
  }
  .tools {
    border-left: 1px solid var(--border);
    padding-left: 0.9rem;
    gap: 0.1rem;
  }
  .tools :is(a, button) {
    display: grid;
    place-items: center;
    height: 2.4rem;
    width: 2.4rem;
  }
  .tools :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .tools [aria-current="page"] {
    color: var(--accent);
  }
  #menu-btn,
  .close-icon {
    display: none;
  }
  #reading-progress {
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (max-width: 42rem) {
    .header-row {
      min-height: 4rem;
      gap: 0.3rem;
    }
    .tools {
      padding: 0;
      border: 0;
      gap: 0;
    }
    .tools :is(a, button) {
      width: 2.2rem;
    }
    #menu-btn {
      display: grid;
    }
    #menu-btn[aria-expanded="true"] .open-icon {
      display: none;
    }
    #menu-btn[aria-expanded="true"] .close-icon {
      display: block;
    }
    #menu-items {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      min-height: 3.2rem;
      justify-content: space-evenly;
      gap: 0.4rem;
      padding: 0.5rem 0.8rem;
      background: var(--background);
      border-block: 1px solid var(--border);
    }
    #menu-items.is-open {
      display: flex;
    }
  }
</style>

<script>
  function setupHeader() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menu = document.querySelector("#menu-items");
    if (!menuBtn || !menu) return;
    const setMenu = (open: boolean) => {
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute(
        "aria-label",
        (open ? menuBtn.dataset.labelClose : menuBtn.dataset.labelOpen) ?? ""
      );
      menu.classList.toggle("is-open", open);
    };
    const controller = new AbortController();
    menuBtn.onclick = () =>
      setMenu(menuBtn.getAttribute("aria-expanded") !== "true");
    document.addEventListener(
      "keydown",
      event => {
        if (
          event.key === "Escape" &&
          menuBtn.getAttribute("aria-expanded") === "true"
        ) {
          setMenu(false);
          menuBtn.focus();
        }
      },
      { signal: controller.signal }
    );

    const progress = document.querySelector<HTMLElement>("#reading-progress");
    const article = document.querySelector("#article");
    if (progress && article) {
      const update = () => {
        const height = document.documentElement.scrollHeight - innerHeight;
        const fraction =
          height > 0 ? Math.min(1, Math.max(0, scrollY / height)) : 0;
        progress.style.transform = `scaleX(${fraction})`;
      };
      window.addEventListener("scroll", update, {
        passive: true,
        signal: controller.signal,
      });
      update();
    }
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
    });
  }
  document.addEventListener("astro:page-load", setupHeader);
</script>
