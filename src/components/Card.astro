---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, pubDatetime, modDatetime, timezone } = data;
const date =
  modDatetime && modDatetime > pubDatetime ? modDatetime : pubDatetime;
const displayDate = new Intl.DateTimeFormat("sv-SE", {
  timeZone: timezone ?? config.site.timezone,
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(date);
const locale = Astro.currentLocale ?? config.site.lang;
const dateLabel = locale.startsWith("zh")
  ? date === pubDatetime
    ? "发布于"
    : "更新于"
  : date === pubDatetime
    ? "Published"
    : "Updated";
---

<li class="entry">
  <time datetime={date.toISOString()} title={dateLabel}
    ><span class="sr-only">{dateLabel} </span>{displayDate}</time
  >
  <div class="entry-copy">
    <Heading transition:name={toTransitionName(id)}>
      <a href={getPostUrl(id, filePath, locale)}>{title}</a>
    </Heading>
  </div>
  <IconArrowRight class="entry-arrow" aria-hidden="true" />
</li>

<style>
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 1rem;
    gap: clamp(0.85rem, 2.5vw, 1.8rem);
    padding: 1.55rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  time {
    color: var(--muted-foreground);
    font: 0.68rem/1.5 var(--station-mono);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .entry-copy a {
    font: 400 clamp(1.3rem, 2.6vw, 1.65rem)/1.5
      var(--station-display, var(--station-serif));
    overflow-wrap: anywhere;
  }
  .entry-copy a::after {
    position: absolute;
    content: "";
    inset: 0;
  }
  .entry-arrow {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .entry:is(:hover, :focus-within) a {
    color: var(--accent);
  }
  .entry:is(:hover, :focus-within) .entry-arrow {
    transform: translateX(0.15rem);
  }
  @media (max-width: 48rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr) 1rem;
      gap: 0.35rem 0.9rem;
      padding: 1.2rem 0;
    }
    time {
      grid-column: 1 / -1;
    }
  }
</style>
